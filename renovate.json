{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "14 days",
  "vulnerabilityAlerts": { "minimumReleaseAge": null },
  "packageRules": [
    { "matchDepTypes": ["peerDependencies"], "rangeStrategy": "widen" },
    { "matchPackageNames": ["@playwright/test", "playwright"], "groupName": "playwright" },
    { "matchPackageNames": ["/^@storybook\\//", "storybook"], "groupName": "storybook" },
    { "matchPackageNames": ["/^@vitest\\//", "vitest"], "groupName": "vitest" },
    { "matchPackageNames": ["/tailwindcss/"], "groupName": "tailwind" }
  ]
}
