{
  "name": "owlky-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:node": "vitest run --project tokens --project styles --project mcp",
    "test:browser": "vitest run --project core --project react --project html",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @owlky/e2e run test",
    "test:visual": "pnpm test:visual:docker",
    "storybook": "pnpm build && pnpm --filter @owlky/storybook run dev",
    "storybook:network": "pnpm storybook --host 0.0.0.0",
    "storybook:build": "pnpm --filter @owlky/storybook run build",
    "website:dev": "pnpm --filter @owlky/website run dev",
    "website:build": "pnpm --filter @owlky/website run build",
    "website:serve": "pnpm --filter @owlky/website run serve",
    "check:packages": "node scripts/check-packages.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm check:boundaries && pnpm check:size && pnpm check:packages && pnpm check:licenses && pnpm check:specs && pnpm check:api && pnpm check:docs && pnpm check:manifest && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-versions.mjs && pnpm install --lockfile-only",
    "release": "pnpm build && pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks",
    "test:visual:docker": "docker run --rm --ipc=host --network=host -v \"$PWD\":/work -w /work/e2e -e CI=1 mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test --grep @visual --project chromium",
    "test:visual:update": "docker run --rm --ipc=host --network=host -v \"$PWD\":/work -w /work/e2e mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test --grep @visual --project chromium --update-snapshots",
    "check:release": "node scripts/check-release.mjs",
    "specs:options": "node scripts/spec-options.mjs",
    "check:specs": "node scripts/spec-options.mjs --check",
    "check:docs": "node apps/storybook/scripts/check-docs-code.mjs",
    "api": "node scripts/api-reference.mjs",
    "check:api": "node scripts/api-reference.mjs --check",
    "manifest": "node scripts/manifest.mjs",
    "check:manifest": "node scripts/manifest.mjs --check",
    "notices": "node scripts/check-licenses.mjs --write",
    "check:licenses": "node scripts/check-licenses.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.19.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
