{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/storybook-static",
      "!**/test-results",
      "!**/playwright-report",
      "!**/*.snap",
      "!**/*.md",
      "!apps/storybook/src/foundations/icons/icon-data.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/tokens/**",
        "packages/styles/**",
        "packages/core/**",
        "packages/html/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Framework independence (ADR-0008): this package must not import React.",
                  "react-dom": "Framework independence (ADR-0008): this package must not import React DOM.",
                  "react/jsx-runtime": "Framework independence (ADR-0008): this package must not use JSX.",
                  "@minimal-tailwind/react": "Framework independence (ADR-0008): HTML/core must not depend on the React package."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/react/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@minimal-tailwind/html": "Framework independence (ADR-0008): React must not depend on the HTML runtime."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "**/scripts/**", "e2e/serve.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.html", "packages/react/src/switch/switch.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useAriaPropsForRole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/html/src/components/*/examples/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    }
  ]
}
