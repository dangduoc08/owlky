# owlky.com server configuration (ADR-0071). Copy to .env.local for `pnpm website:dev`, or set
# these in Vercel (Settings › Environment Variables). Never commit real values.
# Locally every variable is optional: without them the site uses PGlite, a development secret
# and no sign-in providers (or the mock providers: `pnpm --filter @owlky/website serve:mock`).

# The site's origin, no trailing slash. Issuer, OAuth callbacks and the MCP resource derive from
# it: https://owlky.com in production, the preview URL on previews.
BETTER_AUTH_URL=http://localhost:3000

# At least 32 random characters, for example `openssl rand -base64 32`. Signs session cookies and
# encrypts the keys that sign MCP access tokens. Required on Vercel.
BETTER_AUTH_SECRET=

# Neon (or any Postgres) connection string, pooled. Required on Vercel. Empty: PGlite.
DATABASE_URL=

# GitHub OAuth app (github.com/settings/developers): callback URL
# <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client, type "Web application" (console.cloud.google.com › APIs & Services ›
# Credentials): authorized redirect URI <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local only (refused on Vercel) ────────────────────────────────────────────────────────────────
# PGlite data directory when DATABASE_URL is empty; memory:// keeps nothing.
OWLKY_PGLITE_DIR=.data/pglite
# Origin of the mock OAuth providers (scripts/mock-oauth.mjs); serve:mock sets it.
OWLKY_OAUTH_MOCK=
# `off` turns Better Auth's sign-in rate limits off (e2e signs in many times a minute).
OWLKY_AUTH_RATE_LIMIT=
