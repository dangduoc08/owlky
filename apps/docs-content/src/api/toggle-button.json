 "entries": [
  {
   "html": {
    "attribute": "data-ok-toggle-button",
    "events": [
     {
      "cancelable": true,
      "description": "Before a standalone button is pressed or released. `pressed` is the new state. Call `preventDefault()` to keep the current one.",
      "detail": "{ pressed: boolean; }",
      "name": "ok:toggle-button:change"
     }
    ],
    "methods": [
     {
      "description": "Whether the button is pressed.",
      "kind": "property",
      "name": "pressed",
      "type": "boolean"
     },
     {
      "description": "Sets the pressed state without emitting events.",
      "kind": "method",
      "name": "setPressed",
      "type": "(pressed: boolean) => void"
     },
     {
      "description": "Flips the state. Returns `false` if disabled or `ok:toggle-button:change` was prevented.",
      "kind": "method",
      "name": "toggle",
      "type": "() => boolean"
     }
    ],
    "options": [
     {
      "attr": "data-ok-color",
      "default": "standard",
      "description": "Color of the pressed state.",
      "kind": "style",
      "name": "color",
      "values": [
       "standard",
       "primary",
       "secondary",
       "info",
       "success",
       "warning",
       "error"
      ]
     },
     {
      "attr": "data-ok-size",
      "default": "md",
      "description": "Standalone 40 / 48 / 56px; in a group 30 / 38 / 46px.",
      "kind": "style",
      "name": "size",
      "values": [
       "sm",
       "md",
       "lg"
      ]
     },
     {
      "attr": "data-ok-full-width",
      "description": "Stretch to the container width.",
      "kind": "flag",
      "name": "fullWidth"
     },
     {
      "attr": "disabled",
      "description": "Native `disabled`: never toggles.",
      "kind": "native",
      "name": "disabled"
     },
     {
      "attr": "aria-pressed",
      "description": "Pressed state (`selected` / `defaultSelected`).",
      "event": "ok:toggle-button:change",
      "kind": "state",
      "name": "selected"
     }
    ],
    "runtime": "toggle-button"
   },
   "name": "ToggleButton",
   "react": {
    "description": "A native button with `aria-pressed`. Inside a `ToggleButtonGroup` the group owns the state; standalone it is controlled with `selected` / `onChange` or uncontrolled with `defaultSelected`.",
    "native": "HTMLButtonElement",
    "props": [
     {
      "default": "\"standard\"",
      "description": "(or the group's color).",
      "name": "color",
      "type": "\"error\" | \"info\" | \"primary\" | \"secondary\" | \"standard\" | \"success\" | \"warning\""
     },
     {
      "description": "Standalone, uncontrolled: initial pressed state.",
      "name": "defaultSelected",
      "type": "boolean"
     },
     {
      "description": "Stretch to the container width.",
      "name": "fullWidth",
      "type": "boolean"
     },
     {
      "description": "Standalone: called with the requested pressed state.",
      "name": "onChange",
      "type": "((selected: boolean) => void)"
     },
     {
      "description": "Standalone, controlled: pressed state.",
      "name": "selected",
      "type": "boolean"
     },
     {
      "default": "\"md\"",
      "description": "Standalone `sm` 40 · `md` 48 · `lg` 56; in a group 30 / 38 / 46.",
      "name": "size",
      "type": "\"lg\" | \"md\" | \"sm\""
     },
     {
      "description": "Identifies the button inside a `ToggleButtonGroup`.",
      "name": "value",
      "type": "string"
     }
    ]
   }
  },
  {
   "name": "ToggleButtonGroup",
   "react": {
    "description": "A `role=\"group\"` of ToggleButtons.",
    "native": "HTMLDivElement",
    "props": [
     {
      "description": "Passed to every ToggleButton that doesn't set its own.",
      "name": "color",
      "type": "\"error\" | \"info\" | \"primary\" | \"secondary\" | \"standard\" | \"success\" | \"warning\""
     },
     {
      "description": "Uncontrolled initial value.",
      "name": "defaultValue",
      "type": "ToggleGroupValue"
     },
     {
      "description": "Native `disabled`: never toggles.",
      "name": "disabled",
      "type": "boolean"
     },
     {
      "description": "At most one pressed button. Values are `string | null` instead of `string[]`.",
      "name": "exclusive",
      "type": "boolean"
     },
     {
      "description": "Stretch to the container width; the buttons share it.",
      "name": "fullWidth",
      "type": "boolean"
     },
     {
      "description": "Called with the requested value (same shape as `value`).",
      "name": "onChange",
      "type": "((value: ToggleGroupValue) => void)"
     },
     {
      "default": "\"horizontal\"",
      "description": "Row or column.",
      "name": "orientation",
      "type": "\"horizontal\" | \"vertical\""
     },
     {
      "default": "md",
      "description": "Standalone 40 / 48 / 56px; in a group 30 / 38 / 46px.",
      "name": "size",
      "type": "\"lg\" | \"md\" | \"sm\""
     },
     {
      "description": "Controlled value: `string | null` when exclusive, `string[]` otherwise.",
      "name": "value",
      "type": "ToggleGroupValue"
     }
    ]
   }
  },
  {
   "html": {
    "attribute": "data-ok-toggle-group",
    "events": [
     {
      "cancelable": true,
      "description": "Before the group's value changes. Call `preventDefault()` to keep the current one.",
      "detail": "{ value: ToggleGroupValue; previous: ToggleGroupValue; button: Element; }",
      "name": "ok:toggle-group:change"
     }
    ],
    "methods": [
     {
      "description": "Presses exactly the buttons whose `value` is in `value`, without emitting events.",
      "kind": "method",
      "name": "setValue",
      "type": "(value: ToggleGroupValue) => void"
     },
     {
      "description": "Applies a press on `button`. Returns `false` if disabled or the change event was prevented.",
      "kind": "method",
      "name": "toggle",
      "type": "(button: Element) => boolean"
     },
     {
      "description": "`string | null` with `data-ok-exclusive`, `string[]` otherwise.",
      "kind": "property",
      "name": "value",
      "type": "ToggleGroupValue"
     }
    ],
    "options": [
     {
      "attr": "data-ok-orientation",
      "default": "horizontal",
      "description": "Row or column.",
      "kind": "style",
      "name": "orientation",
      "values": [
       "horizontal",
       "vertical"
      ]
     },
     {
      "attr": "data-ok-exclusive",
      "description": "At most one pressed button.",
      "kind": "flag",
      "name": "exclusive"
     },
     {
      "attr": "data-ok-full-width",
      "description": "Stretch to the container width; buttons share it.",
      "kind": "flag",
      "name": "fullWidth"
     },
     {
      "attr": "data-ok-color",
      "children": "[data-ok-toggle-button]",
      "default": "standard",
      "description": "Passed to every button.",
      "kind": "style",
      "name": "color",
      "values": [
       "standard",
       "primary",
       "secondary",
       "info",
       "success",
       "warning",
       "error"
      ]
     },
     {
      "attr": "data-ok-size",
      "children": "[data-ok-toggle-button]",
      "default": "md",
      "description": "Passed to every button.",
      "kind": "style",
      "name": "size",
      "values": [
       "sm",
       "md",
       "lg"
      ]
     },
     {
      "attr": "disabled",
      "children": "[data-ok-toggle-button]",
      "description": "Passed to every button.",
      "kind": "native",
      "name": "disabled"
     },
     {
      "attr": "aria-pressed",
      "description": "Pressed buttons (`value` / `defaultValue`).",
      "event": "ok:toggle-group:change",
      "kind": "state",
      "name": "value"
     }
    ],
    "runtime": "toggle-group"
   },
   "name": "ToggleGroup"
  }
 ],
 "format": 1,
 "imports": {
  "core": "@owlky/core/toggle-button",
  "css": [
   "@owlky/styles/components/toggle-button.css"
  ],
  "html": "@owlky/html/toggle-button",
  "react": "@owlky/react/toggle-button"
 },
 "name": "toggle-button",
 "title": "Toggle button",
 "types": [
