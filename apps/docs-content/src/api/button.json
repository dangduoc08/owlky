 "name": "button",
 "title": "Button",
 "types": [
  {
   "name": "ColorName",
   "type": "\"black\" | \"error\" | \"info\" | \"inherit\" | \"primary\" | \"secondary\" | \"success\" | \"warning\" | \"white\""
  }
 ]
