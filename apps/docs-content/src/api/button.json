 "entries": [
  {
   "html": {
    "attribute": "data-ok-button",
    "options": [
     {
      "attr": "data-ok-variant",
      "default": "text",
      "description": "Visual style.",
      "kind": "style",
      "name": "variant",
      "values": [
       "text",
       "contained",
       "outlined",
       "soft"
      ]
     },
     {
      "attr": "data-ok-color",
      "default": "inherit",
      "description": "`inherit` (neutral), palette, `black` / `white`.",
      "kind": "style",
      "name": "color",
      "values": [
       "inherit",
       "primary",
       "secondary",
       "info",
       "success",
       "warning",
       "error",
       "black",
       "white"
      ]
     },
     {
      "attr": "data-ok-size",
      "default": "md",
      "description": "Height: 30 / 36 / 48 / 56px.",
      "kind": "style",
      "name": "size",
      "values": [
       "sm",
       "md",
       "lg",
       "xl"
      ]
     },
     {
      "attr": "data-ok-full-width",
      "description": "Stretch to the container width.",
      "kind": "flag",
      "name": "fullWidth"
     },
     {
      "attr": "data-ok-disable-elevation",
      "description": "No shadow on contained buttons.",
      "kind": "flag",
      "name": "disableElevation"
     },
     {
      "attr": "data-ok-loading",
      "description": "Loader + `disabled` + `aria-busy` (adds the loader part).",
      "kind": "flag",
      "name": "loading"
     },
     {
      "attr": "data-ok-loading-position",
      "default": "center",
      "description": "Where the loader goes while loading.",
      "kind": "style",
      "name": "loadingPosition",
      "values": [
       "center",
       "start",
       "end"
      ],
      "when": "loading"
     },
     {
      "attr": "disabled",
      "description": "Native `disabled` (links: `aria-disabled`, no `href`).",
      "kind": "native",
      "name": "disabled"
     }
    ],
    "parts": [
     {
      "description": "The decorative icon before (`start`) or after (`end`) the label.",
      "kind": "value",
      "name": "data-ok-button-icon",
      "value": [
       "end",
       "start"
      ]
     },
     {
      "description": "The label: the button's accessible name.",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-button-label"
     },
     {
      "description": "Holds the loading indicator while `data-ok-loading` is set.",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-button-loader"
     },
     {
      "description": "The default loading indicator: a circular progress.",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-button-spinner"
     }
    ]
   },
   "name": "Button",
   "react": {
    "description": "A native `<button type=\"button\">`, an `<a>` when `href` is set (or the `LinkComponent`), or the `component`, such as a router link.",
    "native": "HTMLElement",
    "props": [
     {
      "default": "\"a\"",
      "description": "The component that renders the link instead of an `<a>`, such as a router link. It gets `href` and the button's attributes.",
      "name": "LinkComponent",
      "type": "ElementType"
     },
     {
      "description": "The content.",
      "name": "children",
      "type": "ReactNode"
     },
     {
      "default": "\"inherit\"",
      "description": "(neutral). `black` / `white` are meant for light / dark surfaces.",
      "name": "color",
      "type": "ColorName"
     },
     {
      "description": "The element or component to render, such as a router link.",
      "name": "component",
      "type": "C"
     },
     {
      "description": "No shadow on contained buttons (on by default inside a ButtonGroup).",
      "name": "disableElevation",
      "type": "boolean"
     },
     {
      "description": "Turns the button off: links get `aria-disabled` and leave the tab order.",
      "name": "disabled",
      "type": "boolean"
     },
     {
      "description": "Decorative icon after the label (hidden from assistive technology).",
      "name": "endIcon",
      "type": "ReactNode"
     },
     {
      "description": "Stretch to the container width.",
      "name": "fullWidth",
      "type": "boolean"
     },
     {
      "description": "Shows a loading indicator, disables the button and sets `aria-busy`.",
      "name": "loading",
      "type": "boolean"
     },
     {
      "description": "g. `\"Loading…\"`. Decorative: the label stays the accessible name.",
      "name": "loadingIndicator",
      "type": "ReactNode"
     },
     {
      "default": "center",
      "description": "Where the indicator goes: over the label (`center`) or in place of an icon.",
      "name": "loadingPosition",
      "type": "\"center\" | \"end\" | \"start\""
     },
     {
      "default": "\"md\"",
      "description": "`sm` 30px · `md` 36px · `lg` 48px · `xl` 56px.",
      "name": "size",
      "type": "\"lg\" | \"md\" | \"sm\" | \"xl\""
     },
     {
      "description": "Decorative icon before the label (hidden from assistive technology).",
      "name": "startIcon",
      "type": "ReactNode"
     },
     {
      "default": "\"text\"",
      "description": "Visual style.",
      "name": "variant",
      "type": "\"contained\" | \"outlined\" | \"soft\" | \"text\""
     }
    ]
   }
  }
 ],
