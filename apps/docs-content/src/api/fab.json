   "name": "Fab",
   "react": {
    "description": "A native `<button type=\"button\">`, an `<a>` when `href` is set (or the `LinkComponent`), or the `component`; round fabs need `aria-label`, extended fabs are named by their label.",
    "native": "HTMLElement",
    "props": [
     {
      "default": "\"a\"",
      "description": "The component that renders the link instead of an `<a>`, such as a router link. It gets `href` and the fab's attributes.",
      "name": "LinkComponent",
      "type": "ElementType"
     },
     {
      "description": "Scales up on hover and down while pressed (off with reduced motion).",
      "name": "animate",
      "type": "boolean"
     },
     {
      "default": "\"default\"",
      "description": "`default` (grey), `inherit` (dark) or a palette color.",
      "name": "color",
      "type": "\"black\" | \"default\" | \"error\" | \"info\" | \"inherit\" | \"primary\" | \"secondary\" | \"success\" | \"warning\" | \"white\""
     },
     {
      "description": "The element or component to render, such as a router link.",
      "name": "component",
      "type": "C"
     },
     {
      "description": "Turns the fab off: links get `aria-disabled` and leave the tab order.",
      "name": "disabled",
      "type": "boolean"
     },
     {
      "description": "A pill with an icon and a label instead of a round icon button.",
      "name": "extended",
      "type": "boolean"
     },
     {
      "default": "\"md\"",
      "description": "Round `sm` 40 · `md` 48 · `lg` 56; extended `sm` 36 · `md` 40 · `lg` 48.",
      "name": "size",
