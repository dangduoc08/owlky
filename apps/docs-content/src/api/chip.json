 "entries": [
  {
   "html": {
    "attribute": "data-ok-chip",
    "events": [
     {
      "cancelable": true,
      "description": "Before the chip is removed (its delete icon, Backspace or Delete). Call `preventDefault()` to keep it.",
      "detail": "undefined",
      "name": "ok:chip:delete"
     }
    ],
    "methods": [
     {
      "description": "Removes the chip from view. Returns `false` if `ok:chip:delete` was prevented.",
      "kind": "method",
      "name": "delete",
      "type": "() => boolean"
     }
    ],
    "options": [
     {
      "attr": "data-ok-variant",
      "default": "filled",
      "description": "Fill, outline or tint.",
      "kind": "style",
      "name": "variant",
      "values": [
       "filled",
       "outlined",
       "soft"
      ]
     },
     {
      "attr": "data-ok-color",
      "default": "default",
      "description": "`default` (neutral), palette, `black` / `white`.",
      "kind": "style",
      "name": "color",
      "values": [
       "default",
       "primary",
       "secondary",
       "info",
       "success",
       "warning",
       "error",
       "black",
       "white"
      ]
     },
     {
      "attr": "data-ok-size",
      "default": "medium",
      "description": "Height 32 / 24px.",
      "kind": "style",
      "name": "size",
      "values": [
       "medium",
       "small"
      ]
     },
     {
      "attr": "disabled",
      "children": ":scope > button",
      "description": "Native `disabled` on the chip's buttons.",
      "kind": "native",
      "name": "disabled"
     }
    ],
    "parts": [
     {
      "description": "The chip's main element: a button when the chip is clickable, a link (`a` with `href`) for a link chip, else a `span`.",
      "elements": [
       "a",
       "button",
       "span"
      ],
      "kind": "part",
      "name": "data-ok-chip-action"
     },
     {
      "description": "The delete button.",
      "elements": [
       "button"
      ],
      "kind": "part",
      "name": "data-ok-chip-delete"
     },
     {
      "description": "The icon at the start.",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-chip-icon"
     },
     {
      "description": "The label.",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-chip-label"
     }
    ],
    "runtime": "chip"
   },
   "name": "Chip",
   "react": {
    "description": "A compact element for an attribute, a filter or an action. Clickable chips are buttons; a delete button is separate, with its own name.",
    "native": "HTMLSpanElement",
    "props": [
     {
      "description": "Other props of the action element, such as a router link's `to`.",
      "name": "actionProps",
      "type": "Record<string, unknown>"
     },
     {
      "description": "An `Avatar` before the label.",
      "name": "avatar",
      "type": "ReactNode"
     },
     {
      "description": "Makes the chip a button (also implied by `onClick`).",
      "name": "clickable",
      "type": "boolean"
     },
     {
      "default": "\"default\"",
      "description": "`default` (neutral), palette, `black` / `white`.",
      "name": "color",
      "type": "\"black\" | \"default\" | \"error\" | \"info\" | \"primary\" | \"secondary\" | \"success\" | \"warning\" | \"white\""
     },
     {
      "default": "a",
      "description": "The element or component of the action, such as a router link. with `href`, else `button`.",
      "name": "component",
      "type": "ElementType"
     },
     {
      "description": "Replaces the delete icon.",
      "name": "deleteIcon",
      "type": "ReactNode"
     },
     {
      "default": "\"Remove\"",
      "description": "Name of the delete button.",
      "name": "deleteLabel",
      "type": "string"
     },
     {
      "description": "Disables the chip's buttons.",
      "name": "disabled",
      "type": "boolean"
     },
     {
      "description": "Makes the chip a link: its action is an `<a>` with this URL.",
      "name": "href",
      "type": "string"
     },
     {
      "description": "An icon before the label (when there's no avatar).",
      "name": "icon",
      "type": "ReactNode"
     },
     {
      "description": "The chip's text.",
      "name": "label",
      "required": true,
      "type": "ReactNode"
     },
     {
      "description": "Called when the chip is pressed (its button, or its link with `href`).",
      "name": "onClick",
      "type": "((event: MouseEvent<HTMLAnchorElement | HTMLButtonElement, MouseEvent>) => void)"
     },
     {
      "description": "Renders a delete button that calls it (and Backspace / Delete on the focused chip).",
      "name": "onDelete",
      "type": "(() => void)"
     },
     {
      "description": "The link's relationship to the current page.",
      "name": "rel",
      "type": "string"
     },
     {
      "default": "\"medium\"",
      "description": "`medium` (32px) or `small` (24px).",
      "name": "size",
      "type": "\"medium\" | \"small\""
     },
     {
      "description": "Where the link opens, such as `_blank`. A new tab always gets `rel=\"noopener noreferrer\"`.",
      "name": "target",
      "type": "HTMLAttributeAnchorTarget"
     },
     {
      "default": "\"filled\"",
      "description": "Fill, outline or tint.",
      "name": "variant",
      "type": "\"filled\" | \"outlined\" | \"soft\""
     }
    ]
   }
  }
 ],
 "format": 1,
 "imports": {
  "core": "@owlky/core/chip",
