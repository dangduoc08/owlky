 "entries": [
  {
   "html": {
    "attribute": "data-ok-illustration",
    "methods": [
     {
      "description": "The illustration drawn, or `undefined` when the name is unknown to this set.",
      "kind": "property",
      "name": "illustration",
      "type": "Illustration"
     }
    ],
    "options": [
     {
      "attr": "data-ok-color",
      "default": "primary",
      "description": "Palette of the brand tones (the accent and neutral tones stay).",
      "kind": "style",
      "name": "color",
      "values": [
       "primary",
       "secondary",
       "info",
       "success",
       "warning",
       "error"
      ]
     },
     {
      "attr": "data-ok-size",
      "description": "Width: a number in px, or a CSS length. The height follows the 4:3 picture. Default 480px, never wider than the container.",
      "kind": "number",
      "min": 0,
      "name": "size",
      "units": [
       "px",
       "rem",
       "em"
      ]
     }
    ],
    "parts": [
     {
      "description": "Marks a shape drawn as an outline.",
      "kind": "state",
      "name": "data-ok-stroke"
     },
     {
      "description": "The color tone of a shape, such as `primary` or `neutral`.",
      "kind": "value",
      "name": "data-ok-tone",
      "value": "string"
     }
    ],
    "runtime": "illustration"
   },
   "name": "Illustration",
   "react": {
    "description": "Renders an illustration's node tree as inline SVG; tones follow the theme through the stylesheet. Decorative unless named (`title`, `aria-label` or `aria-labelledby`).",
    "native": "SVGSVGElement",
    "props": [
     {
      "default": "\"primary\"",
      "description": "Palette of the brand tones.",
      "name": "color",
      "type": "\"error\" | \"info\" | \"primary\" | \"secondary\" | \"success\" | \"warning\""
     },
     {
      "description": "The picture: an export of `@owlky/core/illustrations` (such as `error404`) or your own data.",
      "name": "illustration",
      "required": true,
      "type": "Illustration"
     },
     {
      "description": "Width: a number in px, or a CSS length such as `\"20rem\"`. Default 480px, never wider than the container.",
      "name": "size",
      "type": "string | number"
     },
     {
      "description": "The accessible name. With it (or `aria-label` / `aria-labelledby`) the picture is an image (`role=\"img\"`); without, it is decorative (`aria-hidden`).",
      "name": "title",
      "type": "string"
     }
    ]
   }
  }
 ],
 "format": 1,
 "name": "illustration",
 "title": "Illustration"
}
