   "name": "Checkbox",
   "react": {
    "description": "A native `<input type=\"checkbox\">` with themed icons; `ref` and the remaining props go to the input. Name it with a `FormControlLabel`, `aria-label` or `aria-labelledby`.",
    "native": "HTMLInputElement",
    "props": [
     {
      "description": "Replaces the checked icon.",
      "name": "checkedIcon",
      "type": "ReactNode"
     },
     {
      "description": "Class of the root span (other props go to the input).",
