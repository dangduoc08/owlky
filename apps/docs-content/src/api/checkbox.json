      "type": "string"
     },
     {
      "default": "\"primary\"",
      "description": "Color when checked or indeterminate; `default` is the text color.",
      "name": "color",
      "type": "\"default\" | \"error\" | \"info\" | \"primary\" | \"secondary\" | \"success\" | \"warning\""
     },
     {
      "description": "Replaces the unchecked icon.",
      "name": "icon",
      "type": "ReactNode"
     },
     {
      "description": "Mixed state: shows a dash and sets the input's `indeterminate`.",
      "name": "indeterminate",
