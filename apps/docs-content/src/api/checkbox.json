     },
     {
      "description": "Replaces the indeterminate icon.",
      "name": "indeterminateIcon",
      "type": "ReactNode"
     },
     {
      "description": "Called with the new checked state.",
      "name": "onChange",
      "type": "((checked: boolean) => void)"
     },
     {
      "default": "\"medium\"",
      "description": "`medium` (40px target, 24px icon) or `small` (36 / 20px).",
