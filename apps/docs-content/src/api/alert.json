 "entries": [
  {
   "html": {
    "attribute": "data-ok-alert",
    "events": [
     {
      "cancelable": true,
      "description": "Before the alert closes. Call `preventDefault()` to keep it.",
      "detail": "undefined",
      "name": "ok:alert:close"
     }
    ],
    "methods": [
     {
      "description": "Hides the alert. Returns `false` if `ok:alert:close` was prevented.",
      "kind": "method",
      "name": "close",
      "type": "() => boolean"
     }
    ],
    "options": [
     {
      "attr": "data-ok-severity",
      "default": "success",
      "description": "Meaning and default icon.",
      "kind": "style",
      "name": "severity",
      "values": [
       "success",
       "info",
       "warning",
       "error"
      ]
     },
     {
      "attr": "data-ok-variant",
      "default": "standard",
      "description": "Tinted, filled or outlined.",
      "kind": "style",
      "name": "variant",
      "values": [
       "standard",
       "filled",
       "outlined"
      ]
     },
     {
      "attr": "data-ok-color",
      "default": "success",
      "description": "Colors (default: the severity's).",
      "kind": "style",
      "name": "color",
      "values": [
       "success",
       "info",
       "warning",
       "error"
      ]
     },
     {
      "attr": "hidden",
      "description": "Removed from view when its close button is pressed (HTML).",
      "event": "ok:alert:close",
      "kind": "state",
      "name": "open"
     }
    ],
    "parts": [
     {
      "description": "Actions at the end, such as a close button.",
      "elements": [
       "div"
      ],
      "kind": "part",
      "name": "data-ok-alert-action"
     },
     {
      "description": "A button inside the alert that closes it.",
      "kind": "trigger",
      "name": "data-ok-alert-close",
      "value": [
       ""
      ]
     },
     {
      "description": "The severity icon at the start. Leave it out for no icon.",
      "elements": [
       "div"
      ],
      "kind": "part",
      "name": "data-ok-alert-icon"
     },
     {
      "description": "The message, after the title.",
      "elements": [
       "div"
      ],
      "kind": "part",
      "name": "data-ok-alert-message"
     }
    ],
    "runtime": "alert"
   },
   "name": "Alert",
   "react": {
    "description": "`role=\"alert\"` by default (use `role=\"status\"` for non-urgent messages).",
    "native": "HTMLDivElement",
    "props": [
     {
      "description": "Actions at the end (buttons). Replaces the close button.",
      "name": "action",
      "type": "ReactNode"
     },
     {
      "default": "\"Close\"",
      "description": "Name of the close button.",
      "name": "closeText",
      "type": "string"
     },
     {
      "description": "Colors; default: the severity's.",
      "name": "color",
      "type": "\"error\" | \"info\" | \"success\" | \"warning\""
     },
     {
      "description": "Replaces the severity icon; `false` hides it.",
      "name": "icon",
      "type": "ReactNode"
     },
     {
      "description": "Icons per severity, replacing the defaults.",
      "name": "iconMapping",
      "type": "Partial<Record<\"error\" | \"info\" | \"success\" | \"warning\", ReactNode>>"
     },
     {
      "description": "Renders a close button that calls it; stop rendering the alert to dismiss it.",
      "name": "onClose",
      "type": "(() => void)"
     },
     {
      "default": "\"success\"",
      "description": "Meaning and default icon.",
      "name": "severity",
      "type": "\"error\" | \"info\" | \"success\" | \"warning\""
     },
     {
      "default": "\"standard\"",
      "description": "Tinted, filled or outlined.",
      "name": "variant",
      "type": "\"filled\" | \"outlined\" | \"standard\""
     }
    ]
   }
