 "entries": [
  {
   "html": {
    "attribute": "data-ok-pagination",
    "events": [
     {
      "cancelable": true,
      "description": "Before the page changes. Call `preventDefault()` to stay on the current page.",
      "detail": "{ page: number; }",
      "name": "ok:pagination:change"
     }
    ],
    "methods": [
     {
      "description": "The number of pages.",
      "kind": "property",
      "name": "count",
      "type": "number"
     },
     {
      "description": "Current page (1-based).",
      "kind": "property",
      "name": "page",
      "type": "number"
     },
     {
      "description": "Rebuilds the items from the attributes (after changing `data-ok-count`…).",
      "kind": "method",
      "name": "refresh",
      "type": "() => void"
     },
     {
      "description": "Returns `false` if out of range, the current page, or `ok:pagination:change` was prevented.",
      "kind": "method",
      "name": "setPage",
      "type": "(page: number) => boolean"
     }
    ],
    "options": [
     {
      "attr": "data-ok-variant",
      "default": "text",
      "description": "Look of the current page.",
      "kind": "style",
      "name": "variant",
      "values": [
       "text",
       "outlined",
       "soft"
      ]
     },
     {
      "attr": "data-ok-color",
      "default": "standard",
      "description": "Color of the current page (`standard` = neutral).",
      "kind": "style",
      "name": "color",
      "values": [
       "standard",
       "primary",
       "secondary",
       "info",
       "success",
       "warning",
       "error"
      ]
     },
     {
      "attr": "data-ok-shape",
      "default": "circular",
      "description": "Round or 8px corners.",
      "kind": "style",
      "name": "shape",
      "values": [
       "circular",
       "rounded"
      ]
     },
     {
      "attr": "data-ok-size",
      "default": "md",
      "description": "Item size: 26 / 32 / 40px.",
      "kind": "style",
      "name": "size",
      "values": [
       "sm",
       "md",
       "lg"
      ]
     },
     {
      "attr": "data-ok-disabled",
      "description": "Every item is disabled.",
      "kind": "flag",
      "name": "disabled"
     },
     {
      "attr": "data-ok-page",
      "description": "Current page, 1-based (`page` / `defaultPage` + `onChange(page)`).",
      "event": "ok:pagination:change",
      "kind": "state",
      "name": "page"
     }
    ],
    "parts": [
     {
      "description": "The pages always shown at each end. Default 1.",
      "kind": "value",
      "name": "data-ok-boundary-count",
      "value": "string"
     },
     {
      "description": "The number of pages.",
      "kind": "value",
      "name": "data-ok-count",
      "value": "string"
     },
     {
      "description": "The accessible name pattern of the current page, such as `page {page}`.",
      "kind": "value",
      "name": "data-ok-label-current",
      "value": "string"
     },
     {
      "description": "The accessible name pattern of the other pages, such as `Go to page {page}`.",
      "kind": "value",
      "name": "data-ok-label-page",
      "value": "string"
     },
     {
      "description": "An ellipsis that stands for hidden pages.",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-pagination-ellipsis"
     },
     {
      "description": "On a pagination linked to a table: the rows per page.",
      "kind": "value",
      "name": "data-ok-rows-per-page",
      "value": "string"
     },
     {
      "description": "The pages shown on each side of the current one. Default 1.",
      "kind": "value",
      "name": "data-ok-sibling-count",
      "value": "string"
     }
    ],
    "runtime": "pagination"
   },
   "name": "Pagination",
   "react": {
    "description": "",
    "native": "HTMLElement",
    "props": [
     {
      "description": "Pages always shown at each end. Default 1.",
      "name": "boundaryCount",
      "type": "number"
     },
     {
      "default": "\"standard\"",
      "description": "Color of the current page (`standard` = neutral).",
      "name": "color",
      "type": "\"error\" | \"info\" | \"primary\" | \"secondary\" | \"standard\" | \"success\" | \"warning\""
     },
     {
      "description": "Total pages. Default 1.",
      "name": "count",
      "type": "number"
     },
     {
      "description": "Initial page when uncontrolled. Default 1.",
      "name": "defaultPage",
      "type": "number"
     },
     {
      "description": "Every item is disabled.",
      "name": "disabled",
      "type": "boolean"
     },
     {
      "description": "Accessible name of each item (default as MUI: \"Go to page 3\", \"page 2\", \"Go to next page\").",
      "name": "getItemAriaLabel",
      "type": "((type: PaginationItemType, page: number | null, selected: boolean) => string)"
     },
     {
      "description": "Hides the button to the next page.",
      "name": "hideNextButton",
      "type": "boolean"
     },
     {
      "description": "Hides the button to the previous page.",
      "name": "hidePrevButton",
      "type": "boolean"
     },
     {
      "description": "Replaces the first / previous / next / last icons.",
      "name": "icons",
      "type": "Partial<Record<NavType, ReactNode>>"
     },
     {
      "description": "Called with the requested page.",
      "name": "onChange",
      "type": "((page: number) => void)"
     },
     {
      "description": "Controlled current page (1-based).",
      "name": "page",
      "type": "number"
     },
     {
      "description": "item} />`).",
      "name": "renderItem",
      "type": "((item: PaginationRenderItemParams) => ReactNode)"
     },
     {
      "default": "\"circular\"",
      "description": "Round or 8px corners.",
      "name": "shape",
      "type": "\"circular\" | \"rounded\""
     },
     {
      "description": "Shows a button to the first page.",
      "name": "showFirstButton",
      "type": "boolean"
     },
     {
      "description": "Shows a button to the last page.",
      "name": "showLastButton",
      "type": "boolean"
     },
     {
      "description": "Pages always shown on each side of the current one. Default 1.",
      "name": "siblingCount",
      "type": "number"
     },
     {
      "default": "\"md\"",
      "description": "Item size: 26 / 32 / 40px.",
      "name": "size",
      "type": "\"lg\" | \"md\" | \"sm\""
     },
     {
      "default": "\"text\"",
      "description": "Look of the current page.",
      "name": "variant",
      "type": "\"outlined\" | \"soft\" | \"text\""
     }
    ]
   }
  },
  {
   "html": {
    "attribute": "data-ok-pagination-item",
    "description": "A page or navigation button.",
    "elements": [
     "button"
    ]
   },
   "name": "PaginationItem",
   "react": {
    "description": "One item: a page number, previous / next / first / last, or an ellipsis. Use it in `renderItem` for custom content or links.",
    "native": "HTMLElement",
    "props": [
     {
      "description": "Renders a link (`<a>`) instead of a button.",
      "name": "href",
      "type": "string"
     },
     {
      "description": "Icon of a first / previous / next / last item (default chevrons).",
      "name": "icon",
      "type": "ReactNode"
     },
     {
      "description": "Target page (1-based); `null` for ellipses.",
      "name": "page",
      "type": "number | null"
     },
     {
      "description": "The current page (`aria-current=\"page\"`).",
      "name": "selected",
      "type": "boolean"
     },
     {
      "default": "\"page\"",
      "description": "What the item is: a page, an ellipsis or a navigation button.",
      "name": "type",
      "type": "PaginationItemType"
     }
    ]
   }
  }
 ],
 "format": 1,
 "name": "pagination",
 "title": "Pagination",
 "types": [
  {
   "name": "PaginationItemType",
   "type": "\"end-ellipsis\" | \"first\" | \"last\" | \"next\" | \"page\" | \"previous\" | \"start-ellipsis\""
  }
 ]
}
