 "entries": [
  {
   "html": {
    "attribute": "data-ok-switch",
    "options": [
     {
      "attr": "data-ok-color",
      "default": "primary",
      "description": "Track color when on (`default` = text color).",
      "kind": "style",
      "name": "color",
      "values": [
       "default",
       "primary",
       "secondary",
       "info",
       "success",
       "warning",
       "error"
      ]
     },
     {
      "attr": "data-ok-size",
      "default": "medium",
      "description": "Track 34 × 20 / 26 × 16px.",
      "kind": "style",
      "name": "size",
      "values": [
       "medium",
       "small"
      ]
     },
     {
      "attr": "data-ok-edge",
      "default": "start",
      "description": "Negative margin on that side, to align the track with content.",
      "kind": "style",
      "name": "edge",
      "optional": true,
      "values": [
       "start",
       "end"
      ]
     },
     {
      "attr": "disabled",
      "children": ":scope > input",
      "description": "Native `disabled` on the input.",
      "kind": "native",
      "name": "disabled"
     },
     {
      "attr": "checked",
      "description": "Native `checked` (`checked` / `defaultChecked` + `onChange(checked)`).",
      "event": "ok:switch:change",
      "kind": "state",
      "name": "checked"
     }
    ],
    "parts": [
     {
      "description": "The icon in the thumb while on (`checkedIcon`).",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-switch-checked-icon"
     },
     {
      "description": "The icon in the thumb while off (`icon`).",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-switch-icon"
     },
     {
      "description": "The native checkbox (`role=\"switch\"`). It covers the control, invisible.",
      "elements": [
       "input"
      ],
      "kind": "part",
      "name": "data-ok-switch-input"
     },
     {
      "description": "The thumb.",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-switch-thumb"
     },
     {
      "description": "The track.",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-switch-track"
     }
    ]
   },
   "name": "Switch",
   "react": {
    "description": "A native checkbox with `role=\"switch\"`; CSS only. `ref` and the remaining props go to the input. Name it with a `FormControlLabel`, `aria-label` or `aria-labelledby`.",
    "native": "HTMLInputElement",
    "props": [
     {
      "description": "Content of the thumb while the switch is on.",
      "name": "checkedIcon",
      "type": "ReactNode"
     },
     {
      "description": "Class of the root span (other props go to the input).",
      "name": "className",
      "type": "string"
     },
     {
      "default": "\"primary\"",
      "description": "Track color when on; `default` is the text color.",
      "name": "color",
      "type": "\"default\" | \"error\" | \"info\" | \"primary\" | \"secondary\" | \"success\" | \"warning\""
     },
     {
      "description": "Negative margin on that side, to align the track with content.",
      "name": "edge",
      "type": "\"end\" | \"start\" | false"
     },
     {
      "description": "Content of the thumb (such as an icon); also shown when on unless `checkedIcon` is set.",
      "name": "icon",
      "type": "ReactNode"
     },
     {
      "description": "Called with the new checked state.",
      "name": "onChange",
      "type": "((checked: boolean) => void)"
     },
     {
      "default": "\"medium\"",
      "description": "`medium` (34 × 20px track) or `small` (26 × 16px).",
      "name": "size",
      "type": "\"medium\" | \"small\""
     },
     {
      "description": "Style of the root span.",
      "name": "style",
      "type": "CSSProperties"
     }
    ]
   }
  }
 ],
 "format": 1,
 "imports": {
  "core": "@owlky/core/switch",
  "css": [
   "@owlky/styles/components/switch.css"
  ],
  "react": "@owlky/react/switch"
 },
 "name": "switch",
 "title": "Switch"
}
