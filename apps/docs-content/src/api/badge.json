 "entries": [
  {
   "html": {
    "attribute": "data-ok-badge",
    "options": [
     {
      "attr": "data-ok-variant",
      "default": "standard",
      "description": "A count, a dot, or a presence status (`online` `always` `busy` `offline` `invisible`).",
      "kind": "style",
      "name": "variant",
      "values": [
       "standard",
       "dot",
       "online",
       "always",
       "busy",
       "offline",
       "invisible"
      ]
     },
     {
      "attr": "data-ok-color",
      "default": "default",
      "description": "Badge color (standard and dot).",
      "kind": "style",
      "name": "color",
      "values": [
       "default",
       "primary",
       "secondary",
       "info",
       "success",
       "warning",
       "error"
      ]
     },
     {
      "attr": "data-ok-overlap",
      "default": "rectangular",
      "description": "Shape it sits on: `circular` moves it in, onto the circle's edge.",
      "kind": "style",
      "name": "overlap",
      "values": [
       "rectangular",
       "circular"
      ]
     },
     {
      "attr": "data-ok-vertical",
      "default": "top",
      "description": "React: `anchorOrigin.vertical`.",
      "kind": "style",
      "name": "vertical",
      "values": [
       "top",
       "bottom"
      ]
     },
     {
      "attr": "data-ok-horizontal",
      "default": "right",
      "description": "React: `anchorOrigin.horizontal`.",
      "kind": "style",
      "name": "horizontal",
      "values": [
       "right",
       "left"
      ]
     },
     {
      "attr": "data-ok-invisible",
      "description": "Hides the badge (it shrinks away).",
      "kind": "flag",
      "name": "invisible"
     }
    ],
    "parts": [
     {
      "description": "The badge itself: the count, dot or status on the child's corner.",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-badge-badge"
     }
    ]
   },
   "name": "Badge",
   "react": {
    "description": "A count, dot or status on the corner of its child. The count is visible text: also say what it counts in the child's name (for example `aria-label=\"4 new messages\"`).",
    "native": "HTMLSpanElement",
    "props": [
     {
      "default": "{ vertical: \"top\", horizontal: \"right\" }",
      "description": "Corner.",
      "name": "anchorOrigin",
      "type": "Partial<BadgeAnchorOrigin>"
     },
     {
      "description": "The count or text in a standard badge.",
      "name": "badgeContent",
      "type": "ReactNode"
     },
     {
      "default": "\"default\"",
      "description": "(grey).",
      "name": "color",
      "type": "\"default\" | \"error\" | \"info\" | \"primary\" | \"secondary\" | \"success\" | \"warning\""
     },
     {
      "description": "Hide the badge.",
      "name": "invisible",
      "type": "boolean"
     },
     {
      "default": "99",
      "description": "Numbers above it show as `max+`.",
      "name": "max",
      "type": "number"
     },
     {
      "default": "\"rectangular\"",
      "description": "The shape it sits on.",
      "name": "overlap",
      "type": "\"circular\" | \"rectangular\""
     },
     {
      "description": "Show a `0` count (hidden by default).",
      "name": "showZero",
      "type": "boolean"
     },
     {
      "default": "\"standard\"",
      "description": "A count, a dot, or a presence status.",
      "name": "variant",
      "type": "\"always\" | \"busy\" | \"dot\" | \"invisible\" | \"offline\" | \"online\" | \"standard\""
     }
    ]
   }
  }
