 "entries": [
  {
   "html": {
    "attribute": "data-ok-text-field",
    "options": [
     {
      "attr": "data-ok-variant",
      "default": "outlined",
      "description": "Outline, tinted fill or underline.",
      "kind": "style",
      "name": "variant",
      "values": [
       "outlined",
       "filled",
       "standard"
      ]
     },
     {
      "attr": "data-ok-size",
      "default": "medium",
      "description": "Height 56 / 40px (outlined).",
      "kind": "style",
      "name": "size",
      "values": [
       "medium",
       "small"
      ]
     },
     {
      "attr": "data-ok-color",
      "default": "default",
      "description": "Focus color (`default` = text color, as on the reference; MUI's default is `primary`).",
      "kind": "style",
      "name": "color",
      "values": [
       "default",
       "primary",
       "secondary",
       "info",
       "success",
       "warning",
       "error"
      ]
     },
     {
      "attr": "data-ok-error",
      "description": "Error colors; the input gets `aria-invalid`.",
      "kind": "flag",
      "name": "error"
     },
     {
      "attr": "data-ok-full-width",
      "description": "Stretch to the container width.",
      "kind": "flag",
      "name": "fullWidth"
     },
     {
      "attr": "data-ok-margin",
      "default": "none",
      "description": "Vertical margin: 0, 8 / 4px or 16 / 8px.",
      "kind": "style",
      "name": "margin",
      "values": [
       "none",
       "dense",
       "normal"
      ]
     },
     {
      "attr": "data-ok-shrink",
      "description": "Keep the label above the value even when empty.",
      "kind": "flag",
      "name": "shrink"
     },
     {
      "attr": "data-ok-hidden-label",
      "description": "Hide the label visually (it still names the input); the field gets the padding of a field without a label.",
      "kind": "flag",
      "name": "hiddenLabel"
     },
     {
      "attr": "data-ok-focused",
      "description": "Show the focus colors even when the field doesn't have focus.",
      "kind": "flag",
      "name": "focused"
     },
     {
      "attr": "data-ok-notched",
      "description": "Outlined: keep the notch in the outline open (OutlinedInput: room for its `label`).",
      "kind": "flag",
      "name": "notched"
     },
     {
      "attr": "data-ok-disable-underline",
      "description": "Standard: no underline (give the field another focus style).",
      "kind": "flag",
      "name": "disableUnderline"
     },
     {
      "attr": "data-ok-min-rows",
      "description": "Multiline: rows shown at least.",
      "kind": "number",
      "min": 1,
      "name": "minRows"
     },
     {
      "attr": "data-ok-max-rows",
      "description": "Multiline: rows before it scrolls.",
      "kind": "number",
      "min": 1,
      "name": "maxRows"
     },
     {
      "attr": "disabled",
      "children": ":scope > [data-ok-text-field-control] > :is([data-ok-text-field-input]:not([data-ok-select-display]), [data-ok-select-input])",
      "description": "Native `disabled` on the input.",
      "kind": "native",
      "name": "disabled"
     },
     {
      "attr": "required",
      "children": ":scope > [data-ok-text-field-control] > :is([data-ok-text-field-input]:not([data-ok-select-display]), [data-ok-select-input])",
      "description": "Native `required`; the label gets an asterisk.",
      "kind": "native",
      "name": "required"
     },
     {
      "attr": "value",
      "description": "The input's value (`value` / `defaultValue` + `onChange(value)`).",
      "event": "ok:text-field:input",
      "kind": "state",
      "name": "value"
     }
    ],
    "parts": [
     {
      "description": "On an adornment: presses go through it to the input (React `disablePointerEvents`).",
      "kind": "state",
      "name": "data-ok-disable-pointer-events"
     },
     {
      "description": "On the root: a standalone input without a label or a helper text (`InputBase`, `OutlinedInput`, `FilledInput`, `Input`). Without `data-ok-variant` it draws no box.",
      "kind": "state",
      "name": "data-ok-input-base"
     },
     {
      "description": "An adornment before or after the input, such as an icon or a unit.",
      "kind": "value",
      "name": "data-ok-text-field-adornment",
      "value": [
       "end",
       "start"
      ]
     },
     {
      "description": "The asterisk of a required field's label.",
      "elements": [
       "span"
      ],
      "kind": "part",
      "name": "data-ok-text-field-asterisk"
     },
     {
      "description": "The box around the input.",
      "elements": [
       "div"
      ],
      "kind": "part",
      "name": "data-ok-text-field-control"
     },
     {
      "description": "The helper text under the field.",
      "elements": [
       "div"
      ],
      "kind": "part",
      "name": "data-ok-text-field-helper"
     },
     {
      "description": "The input or text area.",
      "elements": [
       "input"
      ],
      "kind": "part",
      "name": "data-ok-text-field-input"
     },
     {
      "description": "The label that floats above the input.",
      "elements": [
       "label"
      ],
      "kind": "part",
      "name": "data-ok-text-field-label"
     },
     {
      "description": "The outline of the outlined variant, with a notch for the label.",
      "elements": [
       "fieldset"
      ],
      "kind": "part",
      "name": "data-ok-text-field-outline"
     },
     {
      "description": "The button that shows and hides a password.",
      "kind": "part",
      "name": "data-ok-text-field-reveal"
     },
     {
      "description": "The arrow icon of a native select field.",
      "kind": "part",
      "name": "data-ok-text-field-select-icon"
     }
    ],
    "runtime": "text-field"
   },
   "name": "TextField",
   "react": {
    "description": "A label, a native `<input>` (or `<textarea>`, `<select>`), optional adornments and helper text. `ref` and the remaining props go to the input.",
    "native": "HTMLElement",
    "props": [
     {
      "description": "native` `false`).",
      "name": "children",
      "type": "ReactNode"
     },
     {
      "description": "Class of the root (other props go to the input).",
      "name": "className",
      "type": "string"
     },
     {
      "default": "\"default\"",
      "description": "Focus color; `default` is the text color.",
      "name": "color",
      "type": "\"default\" | \"error\" | \"info\" | \"primary\" | \"secondary\" | \"success\" | \"warning\""
     },
     {
      "default": "\"div\"",
      "description": "The root element.",
      "name": "component",
      "type": "ElementType"
     },
     {
      "description": "Uncontrolled initial value.",
      "name": "defaultValue",
      "type": "string | number"
     },
     {
      "description": "Standard: draw no underline (give the field another focus style).",
      "name": "disableUnderline",
      "type": "boolean"
     },
     {
      "description": "An `InputAdornment` with `position=\"end\"`.",
      "name": "endAdornment",
      "type": "ReactNode"
     },
     {
      "description": "Error colors and `aria-invalid`.",
      "name": "error",
      "type": "boolean"
     },
     {
      "description": "Show the focus colors even when the field doesn't have focus.",
      "name": "focused",
      "type": "boolean"
     },
     {
      "description": "Stretch to the container width.",
      "name": "fullWidth",
      "type": "boolean"
     },
     {
      "description": "Text under the field, such as a hint or an error message (linked with `aria-describedby`).",
      "name": "helperText",
      "type": "ReactNode"
     },
     {
      "description": "Hide the label visually: it still names the input, and the field is laid out as if it had none (a filled field gets less padding above the value).",
      "name": "hiddenLabel",
      "type": "boolean"
     },
     {
      "description": "The element rendered instead of the `<input>`, such as a masked input. It receives the input's props and `ref`. Multiline fields and selects keep their own element.",
      "name": "inputComponent",
      "type": "ElementType"
     },
     {
      "description": "The floating label; it names the input.",
      "name": "label",
      "type": "ReactNode"
     },
     {
      "default": "\"none\"",
      "description": "Vertical margin.",
      "name": "margin",
      "type": "\"dense\" | \"none\" | \"normal\""
     },
     {
      "description": "Multiline: rows before it scrolls.",
      "name": "maxRows",
      "type": "number"
     },
     {
      "description": "Multiline: rows shown at least (grows with the content where supported).",
      "name": "minRows",
      "type": "number"
     },
     {
      "description": "A `<textarea>` instead of an `<input>`.",
      "name": "multiline",
      "type": "boolean"
     },
     {
      "description": "Outlined: keep the outline's notch open even when the label rests in the box.",
      "name": "notched",
      "type": "boolean"
     },
     {
      "description": "Called with the new value.",
      "name": "onChange",
      "type": "((value: string) => void)"
     },
     {
      "description": "Multiline: fixed number of rows.",
      "name": "rows",
      "type": "number"
     },
     {
      "description": "A native `<select>`; pass `<option>` elements as children.",
      "name": "select",
      "type": "boolean"
     },
     {
      "description": "Select options: `{ native: false }` makes a listbox Select (pass `MenuItem` children).",
      "name": "selectProps",
      "type": "TextFieldSelectProps"
     },
     {
      "description": "Keep the label above the value even when the field is empty.",
      "name": "shrink",
      "type": "boolean"
     },
     {
      "default": "\"medium\"",
      "description": "`medium` or `small` (dense).",
      "name": "size",
      "type": "\"medium\" | \"small\""
     },
     {
      "description": "An `InputAdornment` with `position=\"start\"`.",
      "name": "startAdornment",
      "type": "ReactNode"
     },
     {
      "description": "Style of the root.",
      "name": "style",
      "type": "CSSProperties"
     },
     {
      "description": "Controlled value.",
      "name": "value",
      "type": "string | number"
     },
     {
      "default": "\"outlined\"",
      "description": "Outline, tinted fill or underline.",
      "name": "variant",
      "type": "\"filled\" | \"outlined\" | \"standard\""
     }
    ]
   }
