      "name": "disableElevation"
     },
     {
      "attr": "disabled",
      "children": ":scope > [data-ok-button]",
      "description": "Passed to every button.",
      "kind": "native",
      "name": "disabled"
     }
    ]
   },
   "name": "ButtonGroup",
   "react": {
    "description": "A `role=\"group\"` that joins its Buttons.",
    "native": "HTMLDivElement",
    "props": [
     {
      "default": "inherit",
      "description": "Passed to every button.",
      "name": "color",
      "type": "ColorName"
     },
     {
      "default": "true",
      "description": "Passed to every child Button. (as in the reference).",
      "name": "disableElevation",
      "type": "boolean"
     },
     {
      "description": "Passed to every button.",
      "name": "disabled",
      "type": "boolean"
     },
     {
      "description": "Stretch to the container width; the buttons share it.",
      "name": "fullWidth",
      "type": "boolean"
     },
     {
      "default": "\"horizontal\"",
      "description": "Row or column.",
      "name": "orientation",
      "type": "\"horizontal\" | \"vertical\""
     },
     {
      "default": "md",
      "description": "Passed to every button.",
      "name": "size",
      "type": "\"lg\" | \"md\" | \"sm\" | \"xl\""
     },
     {
      "default": "\"outlined\"",
      "description": "Passed to every child Button that doesn't set its own.",
      "name": "variant",
      "type": "\"contained\" | \"outlined\" | \"soft\" | \"text\""
     }
    ]
   }
