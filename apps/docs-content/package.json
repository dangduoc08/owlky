{
  "name": "@owlky/docs-content",
  "version": "0.0.0",
  "private": true,
  "description": "Owlky's docs content (guides, previews, guide UI), shared by Storybook and the website. Never published.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./guide": "./src/guide/guide.tsx",
    "./guide/host": "./src/guide/host.tsx",
    "./guide/tables": "./src/guide/tables.tsx",
    "./guide/tables-data": "./src/guide/tables-data.ts",
    "./guide/text": "./src/guide/text.ts",
    "./guide/manifest": "./src/guide/manifest.ts",
    "./guide/clipboard": "./src/guide/clipboard.ts",
    "./foundations/colors": "./src/foundations/colors/colors-docs.tsx",
    "./foundations/colors/sections": "./src/foundations/colors/colors-docs-examples.ts",
    "./components/button": "./src/components/button/button-docs.tsx",
    "./components/button/sections": "./src/components/button/button-docs-examples.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@owlky/core": "workspace:*",
    "@owlky/react": "workspace:*",
    "@owlky/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1"
  }
}
