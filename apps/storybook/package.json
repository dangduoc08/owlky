{
  "name": "@minimal-tailwind/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build -o storybook-static --quiet",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@minimal-tailwind/core": "workspace:*",
    "@minimal-tailwind/html": "workspace:*",
    "@minimal-tailwind/react": "workspace:*",
    "@minimal-tailwind/styles": "workspace:*",
    "@minimal-tailwind/tokens": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5"
  }
}
