{
  "name": "@minimal-tailwind/tokens",
  "version": "0.0.0",
  "description": "Design tokens for Minimal Tailwind: palette, typography, radius, shadows and motion as TypeScript and CSS variables.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/minimal-tailwind.git",
    "directory": "packages/tokens"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "tailwindcss",
    "minimal"
  ]
}
