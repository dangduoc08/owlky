{
  "name": "@minimal-tailwind/styles",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@minimal-tailwind/tokens": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "tailwindcss": "4.3.4",
    "@types/node": "^22.19.0"
  },
  "description": "Prebuilt, framework-free CSS for Minimal Tailwind components, plus a Tailwind CSS v4 theme.",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./minimal-tailwind.css": "./dist/minimal-tailwind.css",
    "./minimal-tailwind.min.css": "./dist/minimal-tailwind.min.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./theme.css": "./dist/theme.css",
    "./components/*": "./dist/components/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/minimal-tailwind.git",
    "directory": "packages/styles"
  },
  "keywords": [
    "css",
    "tailwindcss",
    "design-system",
    "minimal",
    "components"
  ]
}
