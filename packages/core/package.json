{
  "name": "@owlky/core",
  "version": "0.0.0",
  "description": "Framework-free behavior and anatomy shared by the Owlky React and HTML implementations.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@owlky/tokens": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/owlky.git",
    "directory": "packages/core"
  },
  "keywords": [
    "accessibility",
    "focus-trap",
    "dialog",
    "headless"
  ]
}
