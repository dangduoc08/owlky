{
  "name": "@owlky/core",
  "version": "0.0.0",
  "description": "Framework-free behavior and anatomy shared by the Owlky React and HTML implementations.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./code-editor": {
      "types": "./dist/code-editor/index.d.ts",
      "import": "./dist/code-editor/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "import": "./dist/map/index.js"
    },
    "./map-worker.js": "./dist/map/worker.js",
    "./illustrations": {
      "types": "./dist/illustrations/index.d.ts",
      "import": "./dist/illustrations/index.js"
    },
    "./adapters/dayjs": {
      "types": "./dist/adapters/dayjs.d.ts",
      "import": "./dist/adapters/dayjs.js"
    },
    "./adapters/date-fns": {
      "types": "./dist/adapters/date-fns.d.ts",
      "import": "./dist/adapters/date-fns.js"
    },
    "./adapters/luxon": {
      "types": "./dist/adapters/luxon.d.ts",
      "import": "./dist/adapters/luxon.js"
    },
    "./adapters/moment": {
      "types": "./dist/adapters/moment.d.ts",
      "import": "./dist/adapters/moment.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-map-worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@owlky/tokens": "workspace:*",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/hast": "3.0.5",
    "hast-util-sanitize": "5.0.2",
    "html-url-attributes": "3.0.1",
    "maplibre-gl": "6.16.0",
    "monaco-editor": "0.57.0",
    "property-information": "7.2.0",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "peerDependencies": {
    "@date-fns/tz": "^1.2.0",
    "date-fns": "^3.6.0 || ^4.0.0",
    "dayjs": "^1.11.0",
    "luxon": "^3.0.0",
    "moment": "^2.29.0",
    "moment-timezone": "^0.5.40 || ^0.6.0"
  },
  "peerDependenciesMeta": {
    "@date-fns/tz": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "luxon": {
      "optional": true
    },
    "moment": {
      "optional": true
    },
    "moment-timezone": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlky/owlky.git",
    "directory": "packages/core"
  },
  "keywords": [
    "accessibility",
    "focus-trap",
    "dialog",
    "headless"
  ],
  "devDependencies": {
    "@date-fns/tz": "1.5.0",
    "@types/luxon": "3.7.6",
    "date-fns": "4.4.0",
    "dayjs": "1.11.23",
    "luxon": "3.7.2",
    "moment": "2.31.0",
    "moment-timezone": "0.6.5"
  }
}
