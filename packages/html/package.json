{
  "name": "@owlky/html",
  "version": "0.0.0",
  "description": "Framework-free Owlky components: copy-paste HTML snippets plus a tiny shared runtime that wires up behavior through data-ok-* attributes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/esm/auto.js",
    "./dist/esm/code-editor.js",
    "./dist/esm/editor.js",
    "./dist/monaco/**",
    "./dist/owlky-code-editor.js",
    "./dist/esm/map.js",
    "./dist/owlky-editor.js",
    "./dist/owlky-map.js",
    "./dist/owlky.js",
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./auto": {
      "types": "./dist/esm/auto.d.ts",
      "import": "./dist/esm/auto.js"
    },
    "./code-editor": {
      "types": "./dist/esm/code-editor.d.ts",
      "import": "./dist/esm/code-editor.js"
    },
    "./editor": {
      "types": "./dist/esm/editor.d.ts",
      "import": "./dist/esm/editor.js"
    },
    "./map": {
      "types": "./dist/esm/map.d.ts",
      "import": "./dist/esm/map.js"
    },
    "./owlky.js": "./dist/owlky.js",
    "./owlky-code-editor.js": "./dist/owlky-code-editor.js",
    "./owlky-editor.js": "./dist/owlky-editor.js",
    "./owlky-map.js": "./dist/owlky-map.js",
    "./owlky-map-worker.js": "./dist/owlky-map-worker.js",
    "./owlky.css": "./dist/owlky.css",
    "./owlky.min.css": "./dist/owlky.min.css",
    "./monaco/*": "./dist/monaco/*",
    "./snippets/*": "./dist/snippets/*",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/owlky.js",
  "jsdelivr": "./dist/owlky.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build && vite build --mode editor && vite build --mode code-editor && vite build --mode monaco && vite build --mode monaco-workers && vite build --mode map && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@owlky/core": "workspace:*"
  },
  "devDependencies": {
    "@owlky/styles": "workspace:*",
    "dayjs": "1.11.23",
    "monaco-editor": "0.57.0",
    "vite": "8.3.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/owlky.git",
    "directory": "packages/html"
  },
  "keywords": [
    "html",
    "vanilla",
    "components",
    "no-framework",
    "accessible",
    "tailwindcss"
  ]
}
