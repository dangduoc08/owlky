{
  "name": "@owlky/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Owlky MCP server code (tools, resources, prompts, search, validate_markup) and the generated manifest, for the remote MCP at owlky.com/mcp (ADR-0071). Not published.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
